{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "controller",
  "description": "Everything the Picta controller window needs, and nothing more. There is no filesystem permission here: all file access goes through Picta's own commands, which only accept .picta documents and supported image files.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:event:allow-emit-to",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-scale-factor",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask"
  ]
}
